---
import BaseLayout from "../layouts/base-layout.astro";
import { CtaSection } from "../sections/cta/cta-section";
import { SiteFooter } from "../sections/footer/site-footer";
import { SiteHeader } from "../sections/header/site-header";
import { HeroSection } from "../sections/hero/hero-section";
import { HowItWorksSection } from "../sections/how-it-works/how-it-works-section";
import { PlaySection } from "../sections/play/play-section";
---

<BaseLayout>
  <SiteHeader client:load />
  <main id="main">
    <HeroSection />
    <PlaySection client:load />
    <HowItWorksSection />
    <CtaSection />
  </main>
  <SiteFooter />
</BaseLayout>
