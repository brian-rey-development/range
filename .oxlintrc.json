{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error",
    "eqeqeq": "error",
    "curly": "error",
    "no-console": "error",
    "max-lines-per-function": ["warn", { "max": 20, "skipBlankLines": true, "skipComments": true }],
    "max-lines": ["error", { "max": 150, "skipBlankLines": true, "skipComments": true }],
    "max-params": ["error", { "max": 4 }],
    "complexity": ["error", { "max": 8 }],
    "no-magic-numbers": [
      "error",
      { "ignore": [-1, 0, 1, 2], "ignoreArrayIndexes": true, "enforceConst": true }
    ],
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "import/no-duplicates": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
  },
  "overrides": [
    {
      "files": ["**/*.config.ts"],
      "rules": { "import/no-default-export": "off" }
    },
    {
      "files": ["**/test-setup.ts"],
      "rules": { "import/no-unassigned-import": "off" }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": { "max-lines-per-function": "off", "no-magic-numbers": "off" }
    }
  ],
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/schema.d.ts", ".venv/**"]
}
