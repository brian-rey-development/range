# Copy to .env for local development. Every variable starts with RANGE_.
RANGE_ENVIRONMENT=local
RANGE_LOG_LEVEL=info

# Matches infra/docker-compose.yml. Start the services with `just up`.
RANGE_DATABASE_URL=postgresql://range:range@localhost:5432/range
RANGE_REDIS_URL=redis://localhost:6379/0

# Optional. Rule bots work without it and only LLM players need a key.
# RANGE_ANTHROPIC_API_KEY=
